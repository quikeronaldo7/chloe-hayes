# ---------------------------------------------------------------------------
# Chloe in Austin: environment variables
# Copy to .env.local for development. Set the same keys in the chloe-hayes Vercel project.
# Chloe's values only: never reuse Kate Anderson's keys, webhook secret or token secret.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Canonical URLs, Stripe return URLs and emailed library links.
# Preview: the stable branch alias. Production (after launch approval): https://chloeinaustin.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Support inbox, once a real, monitored one exists. Unset = no address is shown or claimed anywhere.
# (chloeinaustin.com currently has Resend sending only; receiving is disabled.)
NEXT_PUBLIC_SUPPORT_EMAIL=
# Footer socials. Instagram defaults to @chloe.eats.atx (printed in the guides); "" hides it.
# NEXT_PUBLIC_INSTAGRAM_HANDLE=chloe.eats.atx
# Facebook: no approved URL yet. Set it to show the Facebook link.
NEXT_PUBLIC_FACEBOOK_URL=

# --- Stripe (QR DIGITAL account acct_1UN8LYIhfSP7AoZw, shared with Kate) ---------
# Preview: the TEST secret key (sk_test_…) and the signing secret of Chloe's own TEST webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live payments stay off unless this is "true" AND the key is sk_live_. Leave false until launch approval.
LIVE_PAYMENTS_ENABLED=false
STRIPE_AUTOMATIC_TAX=false
STRIPE_REQUIRE_TERMS=false

# Test commerce: $1 QA prices for every guide and bundle proposal, Stripe TEST mode only.
# Works only with an sk_test_ key, outside Vercel Production, with this set to "true".
# Also turns on stamped placeholder PDFs for guides whose final file isn't locked yet.
# Set on Preview only. Never in Production.
CHLOE_TEST_COMMERCE=false

# Browsing-only switch. Production is browsing-only unless STOREFRONT_MODE=open (launch approval).
STOREFRONT_MODE=

# Local development only (`npm run dev`, no Stripe key): click through checkout without Stripe.
ALLOW_DEMO_CHECKOUT=true

# --- Secure delivery ------------------------------------------------------------
# 32+ random characters, unique to Chloe. Signs library and download links. openssl rand -base64 48
DOWNLOAD_TOKEN_SECRET=

# "local" reads ./private-files (development only; refused on a deployed site).
# "s3" = Chloe's private Cloudflare R2 bucket `chloe-hayes-products` (required on Vercel).
# Use a READ-ONLY token scoped to that bucket only.
STORAGE_DRIVER=local
PRIVATE_FILES_DIR=private-files
S3_ENDPOINT=
S3_BUCKET=chloe-hayes-products
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=

# --- Email (Resend, same account as Kate, Chloe's own verified domain) ------------
# chloeinaustin.com is VERIFIED in Resend (checked 18 Oct 2026). Use an API key scoped to sending.
RESEND_API_KEY=
EMAIL_FROM="Chloe in Austin <hello@chloeinaustin.com>"

# --- Analytics (optional) ---------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
