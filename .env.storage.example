# Copy to .env.storage.local (git-ignored) and fill in with the READ-ONLY R2 token.
# Used only by `npm run verify:storage`. Never put the upload (write) token here.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=chloe-hayes-products
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
